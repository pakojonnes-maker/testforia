<?xml version="1.0" encoding="utf-8"?>
<!-- Con mando, el foco tiene que verse desde el sofá: el botón enfocado se rellena de tinta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/paper" />
            <stroke android:width="2dp" android:color="@color/line" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/ink_2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/sand" />
        </shape>
    </item>
</selector>
