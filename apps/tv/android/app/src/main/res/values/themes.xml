<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de la plataforma, sin AppCompat ni Leanback: la app no necesita más y así el
         APK no arrastra dependencias. -->
    <style name="Theme.VisualTaste" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Raíz de los estilos «Setup.*» del asistente (un nombre con punto hereda del prefijo). -->
    <style name="Setup" />

    <style name="Setup.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Setup.Step">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Setup.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Setup.Status" parent="Setup.Body">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Setup.Note" parent="Setup.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_3</item>
    </style>

    <style name="Setup.Input">
        <item name="android:layout_width">280dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/setup_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Setup.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:background">@drawable/setup_button</item>
        <item name="android:textColor">@color/setup_button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Setup.Button.Primary">
        <item name="android:minWidth">260dp</item>
    </style>
</resources>
