<?xml version="1.0" encoding="utf-8"?>
<!-- Lienzo de tele: 960×540 dp. Todo cabe sin desplazar, pero va en un ScrollView por si
     la tele usa una densidad rara; el ScrollView sigue al foco del mando solo. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="40dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Setup.Title"
            android:text="@string/app_name" />

        <TextView
            style="@style/Setup.Body"
            android:layout_marginBottom="20dp"
            android:text="@string/setup_intro" />

        <!-- 1. Código -->
        <TextView
            style="@style/Setup.Step"
            android:text="@string/setup_code_title" />

        <TextView
            style="@style/Setup.Body"
            android:text="@string/setup_code_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/code_input"
                style="@style/Setup.Input"
                android:hint="@string/setup_code_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                android:maxLength="12" />

            <Button
                android:id="@+id/check_button"
                style="@style/Setup.Button"
                android:layout_marginStart="16dp"
                android:text="@string/setup_code_check" />
        </LinearLayout>

        <TextView
            android:id="@+id/code_status"
            style="@style/Setup.Status" />

        <!-- 2. Permiso -->
        <TextView
            style="@style/Setup.Step"
            android:layout_marginTop="18dp"
            android:text="@string/setup_permission_title" />

        <TextView
            style="@style/Setup.Body"
            android:text="@string/setup_permission_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/permission_button"
                style="@style/Setup.Button"
                android:text="@string/setup_permission_open" />

            <TextView
                android:id="@+id/permission_status"
                style="@style/Setup.Status"
                android:layout_width="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/Setup.Note"
            android:layout_marginTop="8dp"
            android:text="@string/setup_permission_persist" />

        <!-- Android 15+ con la app instalada desde un pendrive: el interruptor sale bloqueado. -->
        <LinearLayout
            android:id="@+id/restricted_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/Setup.Body"
                android:layout_width="0dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:text="@string/setup_restricted_help" />

            <Button
                android:id="@+id/app_info_button"
                style="@style/Setup.Button"
                android:text="@string/setup_restricted_open" />
        </LinearLayout>

        <!-- 3. Solo en TCL -->
        <LinearLayout
            android:id="@+id/tcl_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Setup.Step"
                android:text="@string/setup_tcl_title" />

            <TextView
                style="@style/Setup.Body"
                android:text="@string/setup_tcl_help" />
        </LinearLayout>

        <Button
            android:id="@+id/start_button"
            style="@style/Setup.Button.Primary"
            android:layout_marginTop="24dp"
            android:text="@string/setup_start" />

        <TextView
            style="@style/Setup.Note"
            android:layout_marginTop="14dp"
            android:text="@string/setup_reopen_hint" />
    </LinearLayout>
</ScrollView>
