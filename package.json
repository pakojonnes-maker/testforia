{
  "name": "visualtaste",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:client": "cd apps/client && npm run dev",
    "dev:guide": "cd apps/guide && npm run dev",
    "dev:tv": "cd apps/tv && npm run dev",
    "build:admin": "cd apps/admin && npm run build",
    "build:client": "cd apps/client && npm run build",
    "build:guide": "cd apps/guide && npm run build",
    "build:tv": "cd apps/tv && npm run build",
    "test:authz": "node tests/authz.test.mjs",
    "test:auth": "node tests/auth.test.mjs",
    "test:security": "node tests/sessions-mfa-invites.test.mjs",
    "test:import": "node tests/import.test.mjs",
    "test:translate": "node tests/translate.test.mjs",
    "test": "npm run test:authz && npm run test:auth && npm run test:security && npm run test:import && npm run test:translate"
  },
  "dependencies": {
    "framer-motion": "^12.23.9",
    "react-intersection-observer": "^9.16.0",
    "swiper": "^11.2.10"
  }
}
