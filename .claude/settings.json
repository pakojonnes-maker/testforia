{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler pages deploy*)",
      "Bash(wrangler pages deploy*)",
      "Bash(npx wrangler secret*)",
      "Bash(wrangler secret*)",
      "mcp__cloudflare__execute"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-deploy-guard.mjs"],
            "timeout": 20,
            "statusMessage": "Comprobando git status antes de tocar producción…"
          }
        ]
      }
    ]
  }
}
